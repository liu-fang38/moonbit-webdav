import {
  "localreview/webdav" @lib,
  "moonbitlang/core/json",
}

supported_targets = "js"

pkgtype(kind: "executable")

options(
  link: {
    "js": {
      "exports": [
        "run",
        "encode_path",
        "find_request",
        "transfer_request",
        "resources",
        "xml_document",
        "responses",
        "find_extended",
        "patch_request",
        "lock_spec",
        "lock_result",
        "if_header",
      ],
      "format": "esm",
    },
  },
)
