import {
  "localreview/webdav" @lib,
}

supported_targets = "js"

pkgtype(kind: "executable")

options(
  link: {
    "js": {
      "exports": [
        "run",
        "encode_path",
        "find_request",
        "transfer_request",
        "resources",
      ],
      "format": "esm",
    },
  },
)
